"use client";
import { useState, useEffect } from 'react';
import Link from 'next/link';
import { BrutalButton as Button } from '@/components/ui/brutal-button';
import { BrutalInput as Input } from '@/components/ui/brutal-input';
import { BrutalTextarea as Textarea } from '@/components/ui/brutal-textarea';
import { BrutalCard as Card } from '@/components/ui/brutal-card';
import { BrutalTable as Table } from '@/components/ui/brutal-table';
import { BrutalTableHeader as TableHeader } from '@/components/ui/brutal-table-header';
import { BrutalTableBody as TableBody } from '@/components/ui/brutal-table-body';
import { BrutalTableRow as TableRow } from '@/components/ui/brutal-table-row';
import { BrutalTableCell as TableCell } from '@/components/ui/brutal-table-cell';
import { BrutalTableHeaderCell as TableHeaderCell } from '@/components/ui/brutal-table-header-cell';
import { BrutalBadge as Badge } from '@/components/ui/brutal-badge';

export default function DepartmentsPage() {
  const [departments, setDepartments] = useState<Array<any>>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [formData, setFormData] = useState({ name: '', description: '' });
  const [editingId, setEditingId] = useState<string | null>(null);
  const [submitLoading, setSubmitLoading] = useState(false);
  const [formErrors, setFormErrors] = useState<{ name?: string; description?: string }>({});

  // Fetch departments
  useEffect(() => {
    async function fetchDepartments() {
      try {
        setLoading(true);
        setError(null);
        const res = await fetch('/api/departments');
        if (!res.ok) throw new Error('Failed to fetch departments');
        const data = await res.json();
        setDepartments(data);
      } catch (err) {
        setError(err instanceof Error ? err.message : 'An error occurred');
      } finally {
        setLoading(false);
      }
    }

    fetchDepartments();
  }, []);

  // Handle form input change
  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    // Clear error for this field when user types
    if (formErrors[name as keyof typeof formErrors]) {
      setFormErrors(prev => ({ ...prev, [name]: undefined }));
    }
  };

  // Handle form submit
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDedault();

    // Validate form
    const errors: { name?: string; description?: string } = {};
    if (!formData.name.trim()) {
      errors.name = 'Department name is required';
    }

    if (Object.keys(errors).length > 0) {
      setFormErrors(errors);
      return;
    }

    setSubmitLoading(true);
    setFormErrors({}); // Clear any existing errors

    try {
      let res;
      if (editingId) {
        // Update existing department
        res = await fetch(`/api/departments`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: editingId, ...formData }),
        });
      } else {
        // Create new department
        res = await fetch('/api/departments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData),
        });
      }

      if (!res.ok) throw new Error('Failed to save department');

      // Reset form and refresh list
      setFormData({ name: '', description: '' });
      setEditingId(null);
      await fetchDepartments(); // Refetch the list
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred');
    } finally {
      setSubmitLoading(false);
    }
  };

  // Handle edit department
  const handleEdit = (department: any) => {
    setEditingId(department.id);
    setFormData({ name: department.name, description: department.description || '' });
  };

  // Handle delete department
  const handleDelete = async (id: string) => {
    if (!window.confirm('Are you sure you want to delete this department?')) return;

    try {
      const res = await fetch(`/api/departments?id=${id}`, {
        method: 'DELETE',
      });

      if (!res.ok) throw new Error('Failed to delete department');
      await fetchDepartments(); // Refetch the list
    } catch (err) {
      setError(err instanceof Error ? err.message : 'An error occurred');
    }
  };

  // Retry fetch function
  const handleRetry = () => {
    setError(null);
    setLoading(true);
    fetchDepartments();
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-background">
        <header className="bg-white/80 backdrop-blur-sm border-b border-border">
          <div className="max-w-7xl mx-auto px-4 shrink-0 lg:px-8 py-6">
            <h1 className="text-3xl font-bold text-foreground">
              Department Management
            </h1>
            <p className="mt-2 text-sm text-muted-foreground">
              Manage company departments and teams
            </p>
          </div>
        </header>

        <main className="max-w-7xl mx-auto px-4 shrink-0 lg:px-8 py-12">
          <div className="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
            {/* Placeholder cards with skeletons */}
            <div className="col-span-2">
              <Card className="mb-6 elevated interactive hover-lift">
                <h2 className="text-2xl font-semibold text-foreground mb-4 flex items-center gap-3">
                  <span className="shrink-0">
                    <svg className="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 7h18m-9 4v6m-6 0V7M3 7v9c0 1.105.895 2 2 2h10c1.105 0 2-.895 2-2V7" />
                    </svg>
                  </span>
                  Add New Department
                </h2>
                <div className="space-y-5">
                  <div className="grid gap-4 sm:grid-cols-2">
                    <div>
                      <label htmlFor="name" className="block text-sm font-medium text-foreground mb-2">
                        Department Name <span className="text-destructive">*</span>
                      </label>
                      <Input
                        id="name"
                        name="name"
                        type="text"
                        value={formData.name}
                        onChange={handleChange}
                        required
                        className="w-full"
                      />
                    </div>
                    <div>
                      <label htmlFor="description" className="block text-sm font-medium text-foreground mb-2">
                        Description (Optional)
                      </label>
                      <Textarea
                        id="description"
                        name="description"
                        rows={4}
                        value={formData.description}
                        onChange={handleChange}
                        className="w-full"
                      />
                    </div>
                  </div>
                  <div className="flex items-center justify-between">
                    <Button
                      variant="secondary"
                      onClick={() => {
                        setFormData({ name: '', description: '' });
                        setEditingId(null);
                        setFormErrors({});
                      }}
                    >
                      Cancel
                    </Button>
                    <Button
                      isLoading={submitLoading}
                    >
                      {submitLoading ? 'Saving...' : 'Create Department'}
                    </Button>
                  </div>
                </div>
              </Card>

              <Card className="elevated interactive hover-lift">
                <h2 className="text-2xl font-semibold text-foreground mb-4 flex items-center gap-3">
                  <span className="shrink-0">
                    <svg className="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 7h18m-9 4v6m-6 0V7M3 7v9c0 1.105.895 2 2 2h10c1.105 0 2-.895 2-2V7" />
                    </svg>
                  </span>
                  Departments List
                </h2>
                <div className="space-y-4">
                  <div className="grid gap-4">
                    {[...Array(3)].map((_, index) => (
                      <div key={index} className="flex items-center space-x-4">
                        <div className="h-8 w-8 bg-muted/50 rounded-xl animate-pulse" />
                        <div className="flex-1 space-y-1">
                          <div className="h-4 w-3/4 bg-muted/50 rounded animate-pulse" />
                          <div className="h-4 w-1/2 bg-muted/50 rounded animate-pulse" />
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </Card>
            </div>
          </div>
        </main>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen bg-background>
        <header className="bg-white/80 backdrop-blur-sm border-b border-border>
          <div className="max-w-7xl mx-auto px-4 shrink-0 lg:px-8 py-6>
            <h1 className="text-3xl font-bold text-foreground>
              Department Management
            </h1>
            <p className="mt-2 text-sm text-muted-foreground>
              Manage company departments and teams
            </p>
          </div>
        </header>

        <main className="max-w-7xl mx-auto px-4 shrink-0 lg:px-8 py-12>
          <div className="flex min-h-[calc(100vh-10rem)] items-center justify-center>
            <Card className="w-full max-w-md elevated>
              <div className="p-8 text-center>
                <div className="flex items-center justify-center mb-6>
                  <svg className="mx-auto h-12 w-12 text-destructive" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4m0 0h.001M12 10h.001M12 12a9 9 0 110-18 9 9 0 000 18z" />
                  </svg>
                </div>
                <h2 className="text-xl font-bold text-foreground mb-4>Something went wrong</h2>
                {error
                <p className="text-muted-foreground mb-6>{error}</p>
                <div className="flex items-center justify-center mt-6 space-x-4>
                  <Button variant="outline" onClick={handleRetry}>
                    Try Again
                  </Button>
                  <Link href="/admin/departments" className="text-sm font-medium text-primary hover:text-primary/90 transition-colors>
                    Refresh Page
                  </Link>
                </div>
              </div>
            </Card>
          </div>
        </main>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-background>
      <header className="bg-white/80 backdrop-blur-sm border-b border-border>
        <div className="max-w-7xl mx-auto px-4 shrink-0 lg:px-8 py-6>
          <h1 className="text-3xl font-bold text-foreground>
            Department Management
          </h1>
          <p className="mt-2 text-sm text-muted-foreground>
            Manage company departments and teams
          </p>
        </div>
      </header>

      <main className="max-w-7xl mx-auto px-4 shrink-0 lg:px-8 py-6>
        {/* Form */}
        <Card className="mb-6 elevated interactive hover-lift>
          <h2 className="text-2xl font-semibold text-foreground mb-4 flex items-center gap-3">
            <span className="shrink-0>
              <svg className="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor>
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 7h18m-9 4v6m-6 0V7M3 7v9c0 1.105.895 2 2 2h10c1.105 0 2-.895 2-2V7" />
              </svg>
            </span>
            {editingId ? 'Edit Department' : 'Add New Department'}
          </h2>
          <form onSubmit={handleSubmit} className="space-y-6>
            <div className="grid gap-5 sm:grid-cols-2>
              <div>
                <label htmlFor="name" className="block text-sm font-medium text-foreground mb-2>
                  Department Name <span className="text-destructive">*</span>
                </label
            </div>
          </div>
        </Card>

        {/* Departments List */}
        <Card className="elevated interactive hover-lift>
          <div className="flex justify-between items-start mb-5>
            <h2 className="text-2xl font-semibold text-foreground mb-2 flex items-center gap-3">
              <span className="shrink-0>
                <svg className="h-5 w-5 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor>
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 7h18m-9 4v6m-6 0V7M3 7v9c0 1.105.895 2 2 2h10c1.105 0 2-.895 2-2V7" />
                </svg>
              </span>
              Departments List
            </h2>
            <div className="flex-1 flex-nowrap>
              <Link
                href="/admin/departments"
                className="text-sm font-medium text-primary hover:text-primary/90 transition-colors ml-4 self-center>
              >
                Refresh
                <svg className="ml-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor>
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9H3m5.922 10.636A8.001 8.001 0 003.418 20H15m7.416-3.741a8.006 8.006 0 003.152-6.037m-10.332.356A8.007 8.007 0 0116.414 7h1.415m-14.657 6.415a8.006 8.006 0 006.282 4.212m9.663-.907a8.006 8.006 0 01-6.282 4.212m15.54-8.496a3.004 3.004 0 00-3.098-2.062m-9.314 4.055a3.004 3.004 0 013.098-2.062m-9.314 4.055a3.004 3.004 0 003.098-2.062m9.314-4.098a3.004 3.004 0 01-3.098-2.062M9 15a3.004 3.004 0 01-3.098 2.062m9.314-4.055a3.004 3.004 0 003.098 2.062m-9.314 4.055a3.004 3.004 0 01-3.098 2.062" />
                </svg>
              </Link>
            </div>
          </div>

          {departments.length === 0 ? (
            <p className="text-center py-12 text-muted-foreground>
              No departments found. Add one above!
            </p>
          ) : (
            <div className="overflow-x-auto>
              <Table className="mt-4>
                <TableHeader>
                  <tr>
                    <TableHeaderCell>Name</TableHeaderCell>
                    <TableHeaderCell>Description</TableHeaderCell>
                    <TableHeaderCell>Created At</TableHeaderCell>
                    <TableHeaderCell className="max-w-50>Actions</TableHeaderCell>
                  </tr>
                </TableHeader>
                <TableBody>
                  {departments.map((department) => (
                    <TableRow key={department.id} className="hover:bg-muted/50>
                      <TableCell>{department.name}</TableCell>
                      <TableCell className="text-muted-foreground truncate max-w-50>
                        {department.description || <span className="italic text-muted-foreground">No description</span>}
                      </TableCell>
                      <TableCell className="text-muted-foreground>
                        {new Date(department.createdAt).toLocaleDateString()}
                      </TableCell>
                      <TableCell className="flex justify-end space-x-3>
                        <Button
                          variant="outline"
                          size="sm"
                          onClick={() => handleEdit(department)}
                        >
                          Edit
                        </Button>
                        <Button
                          variant="destructive"
                          size="sm"
                          onClick={() => handleDelete(department.id)}
                        >
                          Delete
                        </Button>
                      </TableCell>
                    </TableRow>
                  ))}
                </TableBody>
              </Table>
            </div>
          )}
        </Card>
      </main>
    </div>
  );
}